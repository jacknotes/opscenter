server:
  port: 18080
  host: 0.0.0.0
  # 首次启动时自动创建的管理员密码（也可通过环境变量 ADMIN_PASSWORD 设置）
  admin_password: your-admin-password
  # CORS 和 WebSocket 允许的来源列表，为空则允许所有来源
  allowed_origins: []
  # SSH known_hosts 文件路径，为空则跳过主机密钥验证（不推荐生产环境）
  known_hosts_path: ""

database:
  host: localhost
  port: 3306
  username: opscenter
  password: your-db-password
  dbname: opscenter
  charset: utf8mb4

redis:
  # standalone 单节点模式 | sentinel 哨兵模式
  mode: standalone
  password: ""
  db: 0
  # 单节点模式配置
  host: localhost
  port: 6379
  # 哨兵模式配置（mode: sentinel 时生效）
  master_name: mymaster
  sentinel_addrs:
    - "10.0.0.1:26379"
    - "10.0.0.2:26379"
    - "10.0.0.3:26379"
  # 连接池配置
  pool_size: 10
  min_idle_conns: 2

jwt:
  secret: your-secret-key-change-in-production
  expire: 24h

crypto:
  key: your-32-char-aes-key-here---!!!!

# 运维超时配置（可选，不配置则使用默认值）
timeouts:
  # SSH 连接超时（默认 10s）
  ssh_connect: 10s
  # SSH 连接空闲超时（默认 10m）
  ssh_idle: 10m
  # SSH 连接最大生命周期（默认 1h）
  ssh_lifetime: 1h
  # SSH 连接清理间隔（默认 5m）
  ssh_cleanup: 5m
  # WebSocket 读超时（默认 60s）
  ws_read: 60s
  # WebSocket ping 间隔（默认 30s）
  ws_ping: 30s
  # 分布式锁超时（默认 10m）
  lock: 10m
  # 预览数据过期时间（默认 5m）
  preview: 5m
  # Dashboard SSH 命令超时（默认 20s）
  dashboard_ssh: 20s

# Nginx 相关配置（可选，不配置则使用默认值）
nginx:
  # 最大备份数量（默认 10）
  max_backups: 10

# 认证相关配置（可选，不配置则使用默认值）
auth:
  # 登录限流：最大失败尝试次数（默认 10）
  max_login_attempts: 10
  # 登录限流：锁定时长（默认 1m）
  login_lock_duration: 1m
