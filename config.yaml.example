server:
  port: 18080
  host: 0.0.0.0
  # 首次启动时自动创建的管理员密码（也可通过环境变量 ADMIN_PASSWORD 设置）
  admin_password: your-admin-password
  # CORS 和 WebSocket 允许的来源列表，为空则允许所有来源
  allowed_origins: []
  # SSH known_hosts 文件路径，为空则跳过主机密钥验证（不推荐生产环境）
  known_hosts_path: ""
  # 是否跳过 SSH 主机密钥验证（默认 true，向后兼容）
  # 生产环境建议：配置 known_hosts_path 并设为 false
  # insecure_ignore_host_key: false

database:
  host: localhost
  port: 3306
  username: opscenter
  password: your-db-password
  dbname: opscenter
  charset: utf8mb4

redis:
  # standalone 单节点模式 | sentinel 哨兵模式
  mode: standalone
  password: ""
  db: 0
  # 单节点模式配置
  host: localhost
  port: 6379
  # 哨兵模式配置（mode: sentinel 时生效）
  master_name: mymaster
  sentinel_addrs:
    - "10.0.0.1:26379"
    - "10.0.0.2:26379"
    - "10.0.0.3:26379"
  # 连接池配置
  pool_size: 10
  min_idle_conns: 2

jwt:
  secret: your-secret-key-change-in-production
  expire: 24h

crypto:
  key: your-32-char-aes-key-here---!!!!

# 运维超时配置（可选，不配置则使用默认值）
timeouts:
  # SSH 连接超时（默认 10s）
  ssh_connect: 10s
  # SSH 连接空闲超时（默认 10m）
  ssh_idle: 10m
  # SSH 连接最大生命周期（默认 1h）
  ssh_lifetime: 1h
  # SSH 连接清理间隔（默认 5m）
  ssh_cleanup: 5m
  # WebSocket 读超时（默认 60s）
  ws_read: 60s
  # WebSocket ping 间隔（默认 30s）
  ws_ping: 30s
  # 分布式锁超时（默认 10m）
  lock: 10m
  # 预览数据过期时间（默认 5m）
  preview: 5m
  # Dashboard SSH 命令超时（默认 20s）
  dashboard_ssh: 20s

# Nginx 相关配置（可选，不配置则使用默认值）
nginx:
  # 最大备份数量（默认 10）
  max_backups: 10

# 认证相关配置（可选，不配置则使用默认值）
auth:
  # 登录限流：最大失败尝试次数（默认 10）
  max_login_attempts: 10
  # 登录限流：锁定时长（默认 1m）
  login_lock_duration: 1m

# 审计日志 JSON 输出（可选，用于 Elasticsearch 等日志系统收集）
# 配合 Filebeat/Fluentd 等采集器将日志发送到 Elasticsearch
audit_log:
  enabled: false
  # file: 输出到文件（推荐，不影响应用日志输出到 stdout）
  # stdout: 输出到标准输出（会禁用 Gin/GORM 日志，仅保留审计 JSON）
  output: file
  #file_path: /var/log/opscenter/audit.log  # output=file 时生效
  #max_output: 4096  # Output 字段最大字符数，默认 4096

# LDAP 认证配置（可选，不配置则不启用）
# 启用后，非 admin 用户可使用域账号密码登录，首次登录自动创建本地用户
ldap:
  enabled: false
  host: "192.168.10.110"
  port: 389
  base_dn: "DC=hs,DC=com"
  bind_dn: "CN=域管理员,OU=Services,OU=Headquarter,DC=hs,DC=com"
  bind_password: ""
  # 用户属性映射（AD 域默认值）
  attributes:
    username: "sAMAccountName"
    name: "displayName"
    email: "mail"
  # 自定义用户搜索过滤器（可选，默认根据 username 属性搜索）
  # user_filter: "(&(objectClass=user)(sAMAccountName=%s))"
  # 是否启用 StartTLS（默认 false）
  start_tls: false
  # 是否跳过 TLS 证书验证（默认 true，兼容自签名证书）
  # 生产环境建议设为 false
  # insecure_skip_verify: false
