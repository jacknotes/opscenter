server:
  port: 18080
  host: 0.0.0.0
  # 首次启动时自动创建的管理员密码（也可通过环境变量 ADMIN_PASSWORD 设置）
  admin_password: your-admin-password
  # CORS 和 WebSocket 允许的来源列表，为空则允许所有来源
  allowed_origins: []
  # SSH known_hosts 文件路径，为空则跳过主机密钥验证（不推荐生产环境）
  known_hosts_path: ""

database:
  host: localhost
  port: 3306
  username: opscenter
  password: your-db-password
  dbname: opscenter
  charset: utf8mb4

redis:
  # standalone 单节点模式 | sentinel 哨兵模式
  mode: standalone
  password: ""
  db: 0
  # 单节点模式配置
  host: localhost
  port: 6379
  # 哨兵模式配置（mode: sentinel 时生效）
  master_name: mymaster
  sentinel_addrs:
    - "10.0.0.1:26379"
    - "10.0.0.2:26379"
    - "10.0.0.3:26379"
  # 连接池配置
  pool_size: 10
  min_idle_conns: 2

jwt:
  secret: your-secret-key-change-in-production
  expire: 24h

crypto:
  key: your-32-char-aes-key-here---!!!!
